rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return /databases/$(database)/documents/admins/$(request.auth.token.email.lower());
    }
    // 등록된 사람 (링컴즈 팀원 + 초대받은 광고주)
    function isAdmin() {
      return signedIn() && exists(me());
    }
    // 권한: 기록이 없으면 뷰어로 취급 / 계정: 기록이 없으면 링컴즈(ringcoms)
    function role() {
      return get(me()).data.get('role', 'viewer');
    }
    function acct() {
      return get(me()).data.get('acct', 'ringcoms');
    }
    // 링컴즈 팀원 (마스터·매니저·뷰어)
    function isTeam() {
      return isAdmin() && acct() == 'ringcoms' && role() in ['master', 'manager', 'viewer'];
    }
    // 수정 가능: 링컴즈 마스터·매니저
    function canEdit() {
      return isTeam() && role() in ['master', 'manager'];
    }
    function isMaster() {
      return isTeam() && role() == 'master';
    }
    // 광고주 계정 사람 (클라이언트·클라이언트 관리자)
    function isClient() {
      return isAdmin() && acct() != 'ringcoms' && role() in ['client', 'clientAdmin'];
    }
    function isClientAdmin() {
      return isClient() && role() == 'clientAdmin';
    }
    function camp(id) {
      return get(/databases/$(database)/documents/campaigns/$(id)).data;
    }
    // 광고주 관리자가 자기 계정에서 직접 운영하는 캠페인 (링컴즈가 운영하는 캠페인은 제외)
    function ownData(d) {
      return d.acct == acct() && d.managed == '';
    }
    function ownsCamp(id) {
      return isClientAdmin() && exists(/databases/$(database)/documents/campaigns/$(id))
        && camp(id).get('acct', 'ringcoms') == acct() && camp(id).get('managed', 'ringcoms') == '';
    }

    // 사람 목록: 팀원은 전체, 광고주는 자기 문서(관리자는 같은 계정 멤버)만
    // 추가는 마스터·매니저 (매니저는 마스터를 만들 수 없음) · 팀원 권한은 ringcoms 계정에만, 광고주 권한은 광고주 계정에만
    match /admins/{email} {
      allow get: if isTeam() || (isAdmin() && email == request.auth.token.email.lower())
        || (isClientAdmin() && resource.data.acct == acct());
      allow list: if isTeam() || (isClientAdmin() && resource.data.acct == acct());
      allow create: if canEdit()
        && (isMaster() || request.resource.data.role in ['manager', 'viewer', 'client', 'clientAdmin'])
        && ((request.resource.data.get('acct', 'ringcoms') == 'ringcoms') == (request.resource.data.role in ['master', 'manager', 'viewer']));
      allow update: if isMaster()
        && ((request.resource.data.get('acct', 'ringcoms') == 'ringcoms') == (request.resource.data.role in ['master', 'manager', 'viewer']));
      allow delete: if (isMaster() && email != request.auth.token.email.lower())
        || (canEdit() && resource.data.get('acct', 'ringcoms') != 'ringcoms');
    }
    // 광고주 계정: 팀원 읽기·마스터·매니저 수정, 광고주는 자기 계정만 읽기
    match /accounts/{aid} {
      allow read: if isTeam() || (isClient() && aid == acct());
      allow write: if canEdit();
    }
    // 캠페인: 팀원 읽기·마스터·매니저 수정 / 광고주 관리자는 자기 계정에서 직접 운영하는 캠페인만
    match /campaigns/{id} {
      allow read: if isTeam() || (isClientAdmin() && ownData(resource.data));
      allow create: if canEdit() || (isClientAdmin() && ownData(request.resource.data));
      allow update: if canEdit() || (isClientAdmin() && ownData(resource.data) && ownData(request.resource.data));
      allow delete: if canEdit() || (isClientAdmin() && ownData(resource.data));
    }
    match /rows/{id} {
      allow read: if isTeam() || ownsCamp(id);
      allow write: if canEdit() || ownsCamp(id);
    }
    // 썸네일(직접 넣은 이미지)
    match /thumbs/{id} {
      allow read: if isTeam() || ownsCamp(id);
      allow write: if canEdit() || ownsCamp(id);
    }
    // 인플루언서 풀: 링컴즈 팀원만
    match /pool/{id} {
      allow read: if isTeam();
      allow write: if canEdit();
    }
    // 광고주 공유용 썸네일·공유본: 링크(토큰)를 아는 사람만 한 건씩 읽기, 목록 조회 불가
    match /sharethumbs/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if canEdit() || (isClientAdmin() && request.resource.data.get('acct', '') == acct() && (resource == null || resource.data.get('acct', '') == acct()));
      allow delete: if canEdit() || (isClientAdmin() && resource.data.get('acct', '') == acct());
    }
    match /shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if canEdit() || (isClientAdmin() && request.resource.data.get('acct', '') == acct() && (resource == null || resource.data.get('acct', '') == acct()));
      allow delete: if canEdit() || (isClientAdmin() && resource.data.get('acct', '') == acct());
    }
    // 클라이언트 공개용 진행 현황 (비용·연락처·주소 없음): 같은 계정 광고주만 읽기
    match /cview/{cid} {
      allow read: if isTeam() || (isClient() && resource.data.acct == acct());
      allow write: if canEdit() || ownsCamp(cid);
    }
    // 광고주 컨펌 (인플루언서 진행 여부): 같은 계정 광고주가 쓰고, 팀원이 읽음
    match /cconfirm/{cid} {
      allow read: if isTeam() || (isClient() && resource.data.acct == acct());
      allow create: if canEdit() || (isClient() && request.resource.data.get('acct', '') == acct()
        && exists(/databases/$(database)/documents/campaigns/$(cid)) && camp(cid).get('acct', 'ringcoms') == acct());
      allow update: if canEdit() || (isClient() && resource.data.get('acct', '') == acct() && request.resource.data.get('acct', '') == acct());
      allow delete: if canEdit();
    }
    // 연동 설정(유튜브 API 키 등): 팀원·광고주 관리자 읽기, 마스터만 수정
    match /settings/{id} {
      allow read: if isTeam() || isClientAdmin();
      allow write: if isMaster();
    }
    // 인플루언서 전용 링크 설정: 브릿지 페이지가 로그인 없이 한 건씩 읽기, 목록은 팀원, 수정은 마스터·매니저(광고주 관리자는 자기 캠페인)
    match /links/{code} {
      allow get: if true;
      allow list: if isTeam();
      allow create, update: if canEdit() || ownsCamp(request.resource.data.cid);
      allow delete: if canEdit() || ownsCamp(resource.data.cid);
    }
    // 링크 집계: 팀원 읽기 / 방문자(로그인 없음)는 n +1, u 0~+1, last(서버 시각)만 바꿀 수 있음 — 숫자 임의 수정·삭제 불가
    match /linkstat/{id} {
      allow get, list: if isTeam() || ownsCamp(resource.data.cid);
      allow create: if (canEdit() || ownsCamp(request.resource.data.cid))
        && request.resource.data.n == 0 && request.resource.data.u == 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', 'u', 'last'])
        && request.resource.data.n == resource.data.n + 1
        && (request.resource.data.u == resource.data.u || request.resource.data.u == resource.data.u + 1)
        && request.resource.data.last is timestamp;
      allow delete: if canEdit();
    }
    // 캠페인 일별 링크 집계 (문서 id = 캠페인id_YYYYMMDD): 방문자는 정해진 숫자 칸만 0→1로 만들거나 +1만 할 수 있음
    match /linkday/{id} {
      function cnt() { return ['v', 'u', 'c', 'ios', 'aos', 'pc']; }
      function z1(k) { return request.resource.data.get(k, 0) in [0, 1]; }
      function inc1(k) { return request.resource.data.get(k, 0) == resource.data.get(k, 0) || request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1; }
      allow get, list: if isTeam() || ownsCamp(resource.data.cid);
      allow create: if request.resource.data.keys().hasOnly(['cid', 'd', 'v', 'u', 'c', 'ios', 'aos', 'pc'])
        && request.resource.data.cid is string && request.resource.data.d is string
        && request.resource.data.d.matches('^[0-9]{8}$')
        && id == request.resource.data.cid + '_' + request.resource.data.d
        && exists(/databases/$(database)/documents/campaigns/$(request.resource.data.cid))
        && z1('v') && z1('u') && z1('c') && z1('ios') && z1('aos') && z1('pc');
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(cnt())
        && inc1('v') && inc1('u') && inc1('c') && inc1('ios') && inc1('aos') && inc1('pc');
      allow delete: if canEdit();
    }
    // 프로필 이미지 등 공개 정보: 누구나 한 건씩 읽기, 마스터·매니저만 수정
    match /public/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if canEdit();
    }
  }
}
